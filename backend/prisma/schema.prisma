datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  password           String?
  name               String
  role               String    @default("student")
  avatar_config      String?   @default("{}")
  xp                 Int?      @default(0)
  level              Int?      @default(1)
  streak             Int?      @default(0)
  last_active        DateTime?
  is_verified        Boolean?  @default(false)
  verification_token String?   @unique
  token_expires_at   DateTime?
  created_at         DateTime? @default(now())

  quizzes            Quiz[]            @relation("UserQuizzes")
  attempts           QuizAttempt[]     @relation("UserAttempts")
  liveSessionsHost   LiveSession[]     @relation("HostSessions")
  liveParticipants   LiveParticipant[] @relation("UserParticipants")
  userAchievements   UserAchievement[] @relation("UserAchievements")
  quizRequests       QuizRequest[]     @relation("TeacherRequests")

  @@map("users")
}

model Quiz {
  id                String    @id @default(uuid())
  title             String
  description       String?
  category          String?   @default("General Knowledge")
  difficulty        String?   @default("medium")
  unit              Int?      @default(1)
  time_per_question Int?      @default(30)
  created_by        String
  is_published      Int?      @default(0)
  is_live           Int?      @default(0)
  live_code         String?
  created_at        DateTime? @default(now())

  creator           User              @relation("UserQuizzes", fields: [created_by], references: [id], onDelete: Cascade)
  questions         Question[]
  attempts          QuizAttempt[]
  liveSessions      LiveSession[]
  requests          QuizRequest[]

  @@map("quizzes")
}

model Question {
  id             String   @id @default(uuid())
  quiz_id        String
  type           String
  question_text  String
  media_url      String?
  options        String?
  correct_answer String
  explanation    String?
  points         Int?     @default(1000)
  order_index    Int?     @default(0)
  slider_min     Float?
  slider_max     Float?
  slider_step    Float?   @default(1)
  slider_unit    String?
  matching_pairs String?

  quiz           Quiz             @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  answers        QuestionAnswer[]

  @@map("questions")
}

model QuizAttempt {
  id              String    @id @default(uuid())
  quiz_id         String
  user_id         String
  score           Int?      @default(0)
  total_points    Int?      @default(0)
  correct_count   Int?      @default(0)
  total_questions Int?      @default(0)
  streak_max      Int?      @default(0)
  time_taken      Int?      @default(0)
  completed_at    DateTime? @default(now())

  quiz            Quiz             @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  user            User             @relation("UserAttempts", fields: [user_id], references: [id], onDelete: Cascade)
  answers         QuestionAnswer[]

  @@map("quiz_attempts")
}

model QuestionAnswer {
  id            String   @id @default(uuid())
  attempt_id    String
  question_id   String
  user_answer   String?
  is_correct    Int?     @default(0)
  points_earned Int?     @default(0)
  time_taken    Int?     @default(0)

  attempt       QuizAttempt @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question      Question    @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@map("question_answers")
}

model LiveSession {
  id               String   @id @default(uuid())
  quiz_id          String
  host_id          String
  join_code        String   @unique
  status           String?  @default("waiting")
  current_question Int?     @default(0)
  started_at       DateTime?
  ended_at         DateTime?
  created_at       DateTime? @default(now())

  quiz             Quiz              @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  host             User              @relation("HostSessions", fields: [host_id], references: [id], onDelete: Cascade)
  participants     LiveParticipant[]

  @@map("live_sessions")
}

model LiveParticipant {
  id          String   @id @default(uuid())
  session_id  String
  user_id     String
  score       Int?     @default(0)
  streak      Int?     @default(0)
  rank        Int?     @default(0)

  session     LiveSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  user        User        @relation("UserParticipants", fields: [user_id], references: [id], onDelete: Cascade)

  @@map("live_participants")
}

model Achievement {
  id                String   @id @default(uuid())
  name              String
  description       String?
  icon              String?  @default("🏆")
  requirement_type  String
  requirement_value Int

  userAchievements  UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id             String    @id @default(uuid())
  user_id        String
  achievement_id String
  earned_at      DateTime? @default(now())

  user           User        @relation("UserAchievements", fields: [user_id], references: [id], onDelete: Cascade)
  achievement    Achievement @relation(fields: [achievement_id], references: [id], onDelete: Cascade)

  @@unique([user_id, achievement_id])
  @@map("user_achievements")
}

model QuizRequest {
  id          String    @id @default(uuid())
  quiz_id     String
  unit        Int
  teacher_id  String
  status      String    @default("pending")
  admin_notes String?
  created_at  DateTime? @default(now())
  updated_at  DateTime? @default(now())

  quiz        Quiz      @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  teacher     User      @relation("TeacherRequests", fields: [teacher_id], references: [id], onDelete: Cascade)

  @@map("quiz_requests")
}
