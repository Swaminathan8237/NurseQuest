# Dependencies
node_modules/

# Build output
frontend/dist/

# Database files
backend/db/*.db
backend/db/*.db-shm
backend/db/*.db-wal

# Environment variables
.env
.env.local
.env.*.local

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Uploads (user-generated content)
backend/uploads/images/*
backend/uploads/videos/*
backend/uploads/audio/*
!backend/uploads/images/.gitkeep
!backend/uploads/videos/.gitkeep
!backend/uploads/audio/.gitkeep

# Logs
*.log
npm-debug.log*

# Test artifacts
frontend/testsprite_tests/tmp/

# Build logs
frontend/build_log.txt

.superpowers/

# Local verification scratch — one-off scripts and standalone preview harnesses
# used to check work against a real database/browser. Never part of a deploy.
backend/__verify_migration.js
frontend/dev-preview.html
frontend/src/dev-preview.jsx
.verify/

# Machine-local editor/agent state. These hold absolute paths and per-machine
# permission grants, so sharing them across checkouts causes more churn than help.
# Note: .claude_backup/agents/*.md stays tracked — those are shared definitions,
# so only the per-machine files inside are excluded.
.claude/
.claude_backup/settings.local.json
.claude_backup/scheduled_tasks.lock
.vscode_backup/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
